# Copy to `.env` locally. Never commit `.env` or real keys.

# ---------------------------------------------------------------------------
# PUBLIC / BROWSER-SAFE
# These names use the VITE_ prefix, so Vite ships them in the client bundle.
# They are safe only because row-level security is enabled. The anon key is
# not a bypass.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# SERVER-ONLY
# No public / VITE_ prefix. The service role key bypasses RLS. Do not import
# these from anything under src/ that runs in the browser (any React
# component, client-only module, or file that a component imports).
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
